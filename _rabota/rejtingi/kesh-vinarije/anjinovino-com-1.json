<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anjino Vino</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@200;300;400&display=swap" rel="stylesheet">
    <style>

        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --forest:     #4a5c42;
            --forest-mid: #3a4d34;
            --sage:       #8a9e7e;
            --sage-light: #b5c4a8;
            --champagne:  #f5f0e6;
            --gold:       #8a7d4a;
            --cream:      #faf7f2;
            --espresso:   #1a1410;
            --terracotta: #a05c3a;
            --blush:      #ede8df;
        }

        body {
            font-family: 'Jost', sans-serif;
            background: var(--cream);
            color: var(--espresso);
        }

        /* ── NAV ── */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 28px 60px;
            background: var(--forest);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid rgba(245,240,230,0.08);
        }

        .logo-text {
            font-family: 'Cormorant Garamond', serif;
            font-size: 28px;
            letter-spacing: 8px;
            font-weight: 300;
            color: var(--champagne);
            text-transform: uppercase;
            text-decoration: none;
            display: block;
        }

        .logo-sub {
            font-size: 8px;
            letter-spacing: 5px;
            color: rgba(245,240,230,0.45);
            text-align: center;
            margin-top: 4px;
            text-transform: uppercase;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 36px;
        }

        nav ul a {
            text-decoration: none;
            color: rgba(245,240,230,0.7);
            font-size: 10px;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            font-weight: 300;
            transition: color 0.3s;
        }

        nav ul a:hover { color: var(--champagne); }

        /* ── LANGUAGE SWITCHER ── */
        .nav-lang {
            display: flex !important;
            align-items: center;
            gap: 8px;
            padding-right: 14px;
            border-right: 1px solid rgba(245,240,230,0.18);
            margin-right: 4px;
        }
        .nav-lang a {
            color: rgba(245,240,230,0.5);
            font-size: 10px;
            letter-spacing: 1.5px;
            text-decoration: none;
            transition: color 0.3s;
            text-transform: uppercase;
        }
        .nav-lang a:hover { color: var(--champagne); }
        .nav-lang a.lang-active { color: var(--champagne); }
        .nav-lang .lang-sep {
            color: rgba(245,240,230,0.25);
            font-size: 10px;
        }

        .nav-toggle {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            background: none;
            border: none;
            padding: 4px;
        }

        .nav-toggle span {
            display: block;
            width: 24px;
            height: 1px;
            background: var(--champagne);
        }

        /* ── HERO WRAPPER — the green frame ── */
        .hero-wrapper {
            background: var(--forest);
            padding: 48px;
        }

        /* ── HERO — the photo inside the frame ── */
        .hero {
            height: 88vh;
            background-image: url('cabin.jpg');
            background-size: cover;
            background-position: center center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 60px 40px;
            position: relative;
            overflow: hidden;
        }

        /* Dark overlay so text is readable */
        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(
                to bottom,
                rgba(15, 25, 15, 0.45) 0%,
                rgba(15, 25, 15, 0.32) 40%,
                rgba(15, 25, 15, 0.65) 100%
            );
            z-index: 0;
        }

        /* Thin gold inner border on the photo */
        .hero::after {
            content: '';
            position: absolute;
            inset: 16px;
            border: 1px solid rgba(138,126,74,0.25);
            z-index: 1;
            pointer-events: none;
        }

        .hero-eyebrow {
            font-size: 14px;
            letter-spacing: 5px;
            color: rgba(245,240,230,0.78);
            text-transform: uppercase;
            margin-bottom: 28px;
            position: relative;
            z-index: 2;
            font-weight: 300;
        }

        .hero-eyebrow::before,
        .hero-eyebrow::after {
            content: '—';
            margin: 0 14px;
            color: var(--gold);
            opacity: 0.6;
        }

        .hero h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 88px;
            letter-spacing: 10px;
            color: var(--champagne);
            font-weight: 300;
            margin-bottom: 10px;
            line-height: 1.05;
            position: relative;
            z-index: 2;
            text-shadow: 0 4px 40px rgba(0,0,0,0.3);
            padding: 24px 48px;
            background: radial-gradient(ellipse at center, rgba(20,35,20,0.65) 0%, transparent 75%);
        }

    .hero-subtitle {
            display: none;
        }

        /* Text below the photo inside the green frame */
        .hero-text-below {
            padding: 40px 48px 48px;
            text-align: center;
        }

        .hero-text-below h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(2.4rem, 7vw, 4.25rem);
            color: var(--champagne);
            font-weight: 300;
            letter-spacing: 4px;
            line-height: 1.15;
            margin-bottom: 24px;
            max-width: 720px;
            margin-left: auto;
            margin-right: auto;
        }

        .hero-text-sub {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(1rem, 2vw, 1.4rem);
            font-style: italic;
            color: rgba(245,240,230,0.65);
            letter-spacing: 0.5px;
            font-weight: 300;
            margin-bottom: 4px;
        }

        .hero-ornament {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 48px;
            position: relative;
            z-index: 2;
        }

        .ornament-line { width: 48px; height: 1px; background: var(--gold); opacity: 0.45; }
        .ornament-diamond { width: 6px; height: 6px; background: var(--gold); transform: rotate(45deg); opacity: 0.65; }

        .hero-btn {
            display: inline-block;
            padding: 15px 48px;
            border: 1px solid rgba(245,240,230,0.3);
            color: var(--champagne);
            text-decoration: none;
            font-size: 9px;
            letter-spacing: 5px;
            text-transform: uppercase;
            transition: all 0.4s;
            position: relative;
            z-index: 2;
            font-weight: 300;
        }

        .hero-btn:hover {
            background: rgba(245,240,230,0.1);
            border-color: rgba(245,240,230,0.6);
        }

        .scroll-hint {
            position: absolute;
            bottom: 36px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            opacity: 0.35;
        }

        .scroll-hint span {
            font-size: 8px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: var(--champagne);
        }

        .scroll-line {
            width: 1px;
            height: 36px;
            background: var(--champagne);
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.2; }
            50% { opacity: 1; }
        }

        /* ── INTRO ── */
        .intro {
            background: var(--blush);
            padding: 80px 60px;
            text-align: center;
        }

        .intro::before {
            content: '✦';
            display: block;
            color: var(--gold);
            font-size: 11px;
            margin-bottom: 28px;
            opacity: 0.45;
        }

        .intro p {
            font-family: 'Cormorant Garamond', serif;
            font-size: 24px;
            font-style: italic;
            color: var(--forest-mid);
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.9;
            font-weight: 300;
        }

        /* ── SECTION LABELS ── */
        .section-eyebrow {
            text-align: center;
            font-size: 9px;
            letter-spacing: 6px;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 18px;
            opacity: 0.7;
        }

        .section-heading {
            text-align: center;
            font-family: 'Cormorant Garamond', serif;
            font-size: 48px;
            font-weight: 300;
            color: var(--forest);
            letter-spacing: 4px;
            margin-bottom: 24px;
        }

        .section-ornament {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 64px;
        }

        .orn-bar { width: 36px; height: 1px; background: var(--gold); opacity: 0.3; }
        .orn-dot { width: 4px; height: 4px; background: var(--gold); transform: rotate(45deg); opacity: 0.5; }

        /* ── WINES ── */
        .wines {
            padding: 100px 60px;
            background: var(--cream);
        }

        .wines-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2px;
            max-width: 1080px;
            margin: 0 auto;
        }

        .wine-card {
            background: var(--champagne);
            padding: 52px 36px;
            text-align: center;
            transition: all 0.4s;
            border: 1px solid transparent;
            cursor: pointer;
        }

        .wine-card:hover {
            background: var(--cream);
            border-color: rgba(138,126,74,0.15);
            transform: translateY(-6px);
            box-shadow: 0 16px 48px rgba(30,45,31,0.06);
        }

        .wine-type {
            font-size: 8px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--sage);
            margin-bottom: 16px;
        }

        .wine-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 32px;
            letter-spacing: 3px;
            color: var(--forest);
            margin-bottom: 18px;
            font-weight: 400;
        }

        .wine-desc {
            font-size: 12px;
            line-height: 2;
            color: #5a4838;
            margin-bottom: 28px;
            font-weight: 300;
        }

        .wine-price-rsd{
            font-family: 'Cormorant Garamond', serif;
            font-size: 20px;
            color: var(--gold);
        }

        /* Tramontana */
        .wine-card.featured {
            grid-column: span 3;
            background: var(--forest);
            padding: 60px 80px;
            text-align: center;
            border: none;
        }

        .wine-card.featured:hover { transform: none; box-shadow: none; }
        .wine-card.featured .wine-type { color: var(--sage-light); opacity: 0.7; }
        .wine-card.featured .wine-name { color: var(--champagne); font-size: 40px; }
        .wine-card.featured .wine-desc { color: var(--sage-light); opacity: 0.8; max-width: 560px; margin: 0 auto 28px; }
        .wine-card.featured .wine-price { color: var(--champagne); opacity: 0.9; }
        .wine-card.featured .wine-price-rsd { color: var(--sage-light); opacity: 0.6; }

        /* Suton Reserve */
        .wine-card.reserve {
            grid-column: span 3;
            background: linear-gradient(135deg, #2a1f1a 0%, #392e26 60%, #4a3728 100%);
            border: 1px solid rgba(138,126,74,0.3);
            padding: 64px 80px;
            text-align: center;
        }

        .wine-card.reserve:hover { transform: none; }
        .wine-card.reserve .wine-type { color: var(--gold); opacity: 0.8; }
        .wine-card.reserve .wine-name { color: var(--champagne); font-size: 52px; letter-spacing: 6px; }
        .wine-card.reserve .wine-desc { color: var(--sage-light); opacity: 0.8; max-width: 680px; margin: 0 auto 16px; }
        .wine-card.reserve .wine-price { color: rgba(245,240,230,0.8); font-size: 13px; letter-spacing: 1px; margin-top: 4px; }

        .reserve-badge {
            font-size: 9px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--gold);
            border: 1px solid rgba(138,126,74,0.4);
            padding: 4px 14px;
            margin-bottom: 32px;
            display: inline-block;
        }

        .reserve-quote {
            font-family: 'Cormorant Garamond', serif;
            font-size: 18px;
            font-style: italic;
            color: var(--champagne);
            margin: 24px auto 32px;
            max-width: 600px;
            opacity: 0.85;
            line-height: 1.8;
        }

        .reserve-divider {
            width: 40px;
            height: 1px;
            background: var(--gold);
            margin: 0 auto 24px;
            opacity: 0.4;
        }

        .reserve-note {
            font-size: 9px;
            letter-spacing: 3px;
            color: var(--gold);
            text-transform: uppercase;
            opacity: 0.7;
        }

        /* ── WINE ORDER BUTTONS ── */
        .wine-order-btn {
            display: inline-block;
            margin-top: 24px;
            padding: 11px 28px;
            border: 1px solid rgba(30,45,31,0.25);
            color: var(--forest);
            text-decoration: none;
            font-size: 9px;
            letter-spacing: 3px;
            text-transform: uppercase;
            font-weight: 300;
            transition: all 0.3s;
        }

        .wine-order-btn:hover {
            background: var(--forest);
            color: var(--champagne);
            border-color: var(--forest);
        }

        .wine-card.featured .wine-order-btn {
            color: var(--champagne);
            border-color: rgba(245,240,230,0.3);
            margin-top: 28px;
        }

        .wine-card.featured .wine-order-btn:hover {
            background: rgba(245,240,230,0.12);
            border-color: rgba(245,240,230,0.65);
            color: var(--champagne);
        }

        .wine-card.reserve .wine-order-btn {
            color: var(--gold);
            border-color: rgba(138,126,74,0.4);
            margin-top: 20px;
        }

        .wine-card.reserve .wine-order-btn:hover {
            background: rgba(138,126,74,0.15);
            border-color: var(--gold);
            color: var(--champagne);
        }

        /* ── STORY ── */
        .story {
            background: var(--blush);
            padding: 100px 60px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
        }

        .story-year {
            font-size: 9px;
            letter-spacing: 5px;
            color: var(--gold);
            text-transform: uppercase;
            margin-bottom: 20px;
            opacity: 0.7;
        }

        .story-text h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 48px;
            font-weight: 300;
            color: var(--forest);
            letter-spacing: 3px;
            margin-bottom: 32px;
        }

        .story-text p {
            font-size: 14px;
            line-height: 2.1;
            color: #5a4838;
            margin-bottom: 20px;
            font-weight: 300;
        }

        .story-btn {
            display: inline-block;
            padding: 13px 36px;
            border: 1px solid rgba(30,45,31,0.25);
            color: var(--forest);
            text-decoration: none;
            font-size: 9px;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-top: 20px;
            transition: all 0.3s;
        }

        .story-btn:hover { background: var(--forest); color: var(--champagne); }

        .story-image {
            height: 540px;
            overflow: hidden;
            position: relative;
        }

        .story-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .story-image-frame {
            position: absolute;
            top: 16px; left: 16px; right: 16px; bottom: 16px;
            border: 1px solid rgba(138,126,74,0.2);
            pointer-events: none;
        }

        /* ── VISIT STRIP ── */
        .visit-strip {
            background: var(--forest);
            padding: 80px 60px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
            text-align: center;
        }

        .visit-item h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 22px;
            color: var(--champagne);
            font-weight: 300;
            letter-spacing: 2px;
            margin-bottom: 12px;
        }

        .visit-item p {
            font-size: 12px;
            color: var(--sage-light);
            line-height: 1.9;
            font-weight: 300;
            opacity: 0.7;
        }

        /* ── FOOTER ── */
        footer {
            background: #4a5c42;
            padding: 56px 60px;
            text-align: center;
        }

        .footer-logo {
            font-family: 'Cormorant Garamond', serif;
            font-size: 22px;
            letter-spacing: 10px;
            color: var(--champagne);
            font-weight: 300;
            margin-bottom: 6px;
            opacity: 0.9;
        }

        .footer-sub {
            font-size: 8px;
            letter-spacing: 4px;
            color: var(--sage-light);
            text-transform: uppercase;
            margin-bottom: 36px;
            opacity: 0.5;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 36px;
            margin-bottom: 32px;
            list-style: none;
            flex-wrap: wrap;
        }
        .footer-links a {
            color: var(--sage-light);
            text-decoration: none;
            font-size: 9px;
            letter-spacing: 2px;
            text-transform: uppercase;
            opacity: 0.5;
            transition: opacity 0.3s;
        }

        .footer-links a:hover { opacity: 1; }

        .footer-contact {
            font-size: 12px;
            color: var(--sage-light);
            line-height: 2;
            font-weight: 300;
            margin-bottom: 32px;
            opacity: 0.5;
        }

        .footer-copy {
            font-size: 10px;
            color: var(--sage-light);
            opacity: 0.2;
            letter-spacing: 1px;
        }

        /* ── INTEGRITY STRIP ── */
        .integrity {
            background: var(--champagne);
            padding: 90px 60px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 60px;
            text-align: center;
            border-top: 1px solid rgba(138,126,74,0.18);
            border-bottom: 1px solid rgba(138,126,74,0.18);
        }

        .integrity-pillar {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .integrity-icon {
            width: 6px;
            height: 6px;
            background: var(--gold);
            transform: rotate(45deg);
            opacity: 0.55;
            margin-bottom: 28px;
        }

        .integrity-number {
            font-family: 'Cormorant Garamond', serif;
            font-size: 56px;
            font-weight: 300;
            color: var(--forest);
            letter-spacing: 4px;
            line-height: 1;
            margin-bottom: 16px;
        }

        .integrity-label {
            font-size: 9px;
            letter-spacing: 5px;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 20px;
            opacity: 0.85;
        }

        .integrity-desc {
            font-family: 'Cormorant Garamond', serif;
            font-size: 16px;
            font-style: italic;
            line-height: 1.85;
            color: #5a4838;
            max-width: 260px;
            font-weight: 300;
        }

        /* ── ALLOCATION LIST ── */
        .allocation {
            background: var(--forest);
            padding: 110px 60px;
            text-align: center;
            position: relative;
        }

        .allocation::before {
            content: '';
            position: absolute;
            inset: 24px;
            border: 1px solid rgba(138,126,74,0.2);
            pointer-events: none;
        }

        .allocation-eyebrow {
            font-size: 9px;
            letter-spacing: 6px;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 18px;
            opacity: 0.85;
            position: relative;
        }

        .allocation h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 52px;
            font-weight: 300;
            color: var(--champagne);
            letter-spacing: 5px;
            margin-bottom: 24px;
            position: relative;
        }

        .allocation-ornament {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 32px;
            position: relative;
        }

        .allocation-orn-bar { width: 36px; height: 1px; background: var(--gold); opacity: 0.4; }
        .allocation-orn-dot { width: 4px; height: 4px; background: var(--gold); transform: rotate(45deg); opacity: 0.6; }

        .allocation-lead {
            font-family: 'Cormorant Garamond', serif;
            font-size: 20px;
            font-style: italic;
            color: rgba(245,240,230,0.8);
            max-width: 600px;
            margin: 0 auto 44px;
            line-height: 1.85;
            font-weight: 300;
            position: relative;
        }

        .allocation-form {
            display: flex;
            justify-content: center;
            max-width: 540px;
            margin: 0 auto;
            position: relative;
        }

        .allocation-form input[type="email"] {
            flex: 1;
            min-width: 0;
            padding: 16px 22px;
            background: transparent;
            border: 1px solid rgba(245,240,230,0.28);
            border-right: none;
            color: var(--champagne);
            font-family: 'Jost', sans-serif;
            font-size: 13px;
            letter-spacing: 1.5px;
            outline: none;
            transition: border-color 0.3s;
        }

        .allocation-form input[type="email"]::placeholder {
            color: rgba(245,240,230,0.4);
            letter-spacing: 1.5px;
        }

        .allocation-form input[type="email"]:focus {
            border-color: rgba(245,240,230,0.55);
        }

        .allocation-form button {
            padding: 16px 30px;
            background: transparent;
            border: 1px solid rgba(245,240,230,0.4);
            color: var(--champagne);
            font-family: 'Jost', sans-serif;
            font-size: 9px;
            letter-spacing: 4px;
            text-transform: uppercase;
            cursor: pointer;
            font-weight: 300;
            transition: all 0.4s;
            white-space: nowrap;
        }

        .allocation-form button:hover {
            background: rgba(245,240,230,0.1);
            border-color: rgba(245,240,230,0.7);
        }

        .allocation-cta {
            display: inline-block;
            padding: 18px 40px;
            background: transparent;
            border: 1px solid rgba(245,240,230,0.4);
            color: var(--champagne);
            text-decoration: none;
            font-family: 'Jost', sans-serif;
            font-size: 10px;
            letter-spacing: 4px;
            text-transform: uppercase;
            font-weight: 300;
            transition: all 0.4s;
            position: relative;
        }

        .allocation-cta:hover {
            background: rgba(245,240,230,0.1);
            border-color: rgba(245,240,230,0.7);
        }

        .allocation-fineprint {
            font-size: 9px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--sage-light);
            opacity: 0.5;
            margin-top: 28px;
            line-height: 1.8;
            position: relative;
        }

        /* Hero CTA spacing */
        .hero-text-below .hero-btn {
            margin-top: 32px;
        }

        /* ── NAV SOCIAL ── */
        .nav-social a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 4px 0;
        }

        .nav-social svg {
            display: block;
            width: 15px;
            height: 15px;
        }

        /* ── INSTAGRAM SECTION ── */
        .instagram-section {
            background: var(--cream);
            padding: 100px 60px;
            text-align: center;
        }

        .instagram-lead {
            font-family: 'Cormorant Garamond', serif;
            font-size: 18px;
            font-style: italic;
            color: #5a4838;
            max-width: 540px;
            margin: 0 auto 56px;
            line-height: 1.85;
            font-weight: 300;
        }

        .instagram-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 4px;
            max-width: 960px;
            margin: 0 auto 56px;
        }

        .instagram-tile {
            aspect-ratio: 1 / 1;
            background-size: cover;
            background-position: center;
            display: block;
            position: relative;
            overflow: hidden;
        }

        .instagram-tile::after {
            content: '@';
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(74,92,66,0);
            color: rgba(245,240,230,0);
            font-family: 'Cormorant Garamond', serif;
            font-size: 40px;
            font-weight: 300;
            transition: all 0.4s;
        }

        .instagram-tile:hover::after {
            background: rgba(74,92,66,0.55);
            color: var(--champagne);
        }

        .instagram-btn {
            display: inline-block;
            padding: 13px 36px;
            border: 1px solid rgba(30,45,31,0.25);
            color: var(--forest);
            text-decoration: none;
            font-size: 9px;
            letter-spacing: 3px;
            text-transform: uppercase;
            transition: all 0.3s;
            font-weight: 300;
        }

        .instagram-btn:hover {
            background: var(--forest);
            color: var(--champagne);
            border-color: var(--forest);
        }

        /* ── FOOTER SOCIAL ── */
        .footer-social {
            margin-bottom: 32px;
        }

        .footer-social a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--sage-light);
            opacity: 0.55;
            transition: opacity 0.3s;
        }

        .footer-social a:hover { opacity: 1; }
        .footer-social svg { display: block; width: 20px; height: 20px; }

        /* ── MOBILE ── */
        @media (max-width: 768px) {

            nav { padding: 20px 24px; flex-wrap: wrap; }
            .nav-toggle { display: flex; }

            nav ul {
                display: none;
                flex-direction: column;
                width: 100%;
                gap: 0;
                padding: 16px 0;
                border-top: 1px solid rgba(245,240,230,0.1);
                margin-top: 16px;
            }

            nav ul.open { display: flex; }
            nav ul li a { display: block; padding: 12px 0; }

            .hero-wrapper { padding: 16px; }
            .hero { height: 65vh; min-height: 420px; }
            .hero-text-below { padding: 32px 16px 36px; }
            .hero-text-below .hero-btn { margin-top: 28px; padding: 14px 32px; letter-spacing: 4px; }

            .intro { padding: 56px 24px; }
            .intro p { font-size: 20px; }

            .wines { padding: 72px 20px; }
            .wines-grid { grid-template-columns: 1fr; gap: 2px; }
            .wine-card { padding: 44px 24px; }
            .wine-card.featured,
            .wine-card.reserve { grid-column: span 1; padding: 48px 24px; }
            .wine-order-btn { padding: 13px 28px; margin-top: 22px; }
            .wine-card.featured .wine-order-btn,
            .wine-card.reserve .wine-order-btn { padding: 13px 28px; }

            .story { grid-template-columns: 1fr; gap: 40px; padding: 72px 24px; }
            .story-image { height: 360px; }
            .story-btn { padding: 14px 36px; }

            .visit-strip { grid-template-columns: 1fr; padding: 60px 24px; }
            footer { padding: 48px 24px; }

            .integrity {
                grid-template-columns: 1fr;
                gap: 56px;
                padding: 64px 24px;
            }
            .integrity-number { font-size: 44px; }

            .allocation { padding: 72px 20px; }
            .allocation::before { inset: 12px; }
            .allocation h2 { font-size: 36px; letter-spacing: 3px; }
            .allocation-form { flex-direction: column; gap: 12px; }
            .allocation-form input[type="email"] {
                border-right: 1px solid rgba(245,240,230,0.28);
            }
            .allocation-form button { padding: 14px 28px; }

            .instagram-section { padding: 64px 24px; }
            .instagram-grid { grid-template-columns: repeat(2, 1fr); gap: 4px; max-width: 100%; margin-bottom: 40px; }
            .instagram-lead { font-size: 16px; margin-bottom: 40px; }
        }

    </style>
