i i najkompleksniji izraz Crne Tamjanike.<\/div>\n<\/div>\n<\/div>\n<div class=\"x1h91t0o xkh2ocl x78zum5 xdt5ytf x13a6bvl x193iq5w x1iyjqo2 xcrg951\" role=\"none\"><\/div>","on_sale":false,"prices":{"price":"1400","regular_price":"1400","sale_price":"1400","price_range":null,"currency_code":"RSD","currency_symbol":"\u0440\u0441\u0434","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u0440\u0441\u0434"},"price_html":"<span class=\"woocommerce-Price-amount amount\">1.400&nbsp;<span class=\"woocommerce-Price-currencySymbol\">&#1088;&#1089;&#1076;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":2289,"src":"https:\/\/podrummalca.com\/wp-content\/uploads\/2023\/04\/342078961_781608053347992_4330442706187257084_n.jpg","thumbnail":"https:\/\/podrummalca.com\/wp-content\/uploads\/2023\/04\/342078961_781608053347992_4330442706187257084_n-300x300.jpg","srcset":"http:\/\/podrummalca.com\/wp-content\/uploads\/2023\/04\/342078961_781608053347992_4330442706187257084_n.jpg 1066w, http:\/\/podrummalca.com\/wp-content\/uploads\/2023\/04\/342078961_781608053347992_4330442706187257084_n-600x901.jpg 600w, http:\/\/podrummalca.com\/wp-content\/uploads\/2023\/04\/342078961_781608053347992_4330442706187257084_n-200x300.jpg 200w, http:\/\/podrummalca.com\/wp-content\/uploads\/2023\/04\/342078961_781608053347992_4330442706187257084_n-682x1024.jpg 682w, http:\/\/podrummalca.com\/wp-content\/uploads\/2023\/04\/342078961_781608053347992_4330442706187257084_n-768x1153.jpg 768w, http:\/\/podrummalca.com\/wp-content\/uploads\/2023\/04\/342078961_781608053347992_4330442706187257084_n-1023x1536.jpg 1023w","sizes":"(max-width: 1066px) 100vw, 1066px","thumbnail_srcset":"http:\/\/podrummalca.com\/wp-content\/uploads\/2023\/04\/342078961_781608053347992_4330442706187257084_n-300x300.jpg 300w, http:\/\/podrummalca.com\/wp-content\/uploads\/2023\/04\/342078961_781608053347992_4330442706187257084_n-1